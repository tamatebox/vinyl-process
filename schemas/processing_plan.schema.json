{
  "$defs": {
    "DeclickPlan": {
      "additionalProperties": false,
      "properties": {
        "algorithm": {
          "default": "block_ratio",
          "title": "Algorithm",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "engine": {
          "default": "native",
          "title": "Engine",
          "type": "string"
        },
        "max_click_width_ms": {
          "default": 2.0,
          "exclusiveMinimum": 0,
          "title": "Max Click Width Ms",
          "type": "number"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "preset": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Preset"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "threshold": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "title": "DeclickPlan",
      "type": "object"
    },
    "DecracklePlan": {
      "additionalProperties": false,
      "description": "Crackle is not clicks, and this is not ``declick`` with a lower threshold.\n\nCrackle is a bed of one-to-three sample events, repeated densely enough to be\nheard as a continuous texture rather than as countable ticks. Each is a weak\noutlier and there are thousands of them, so a collective threshold low enough\nto catch them interpolates the music long before it clears the bed. The tool\nfor it examines every sample individually \u2014 which is why this is a separate\nstage with its own algorithm, and why lowering ``declick.threshold`` is the\nwrong lever.\n\nRuns on the whole side in the pre-split phase, after ``declick``: discrete\ndefects before continuous ones. Optional and disabled by default.",
      "properties": {
        "algorithm": {
          "default": "curvature_ratio",
          "title": "Algorithm",
          "type": "string"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "engine": {
          "default": "native",
          "title": "Engine",
          "type": "string"
        },
        "max_event_width_samples": {
          "default": 3,
          "maximum": 16,
          "minimum": 1,
          "title": "Max Event Width Samples",
          "type": "integer"
        },
        "params": {
          "additionalProperties": true,
          "title": "Params",
          "type": "object"
        },
        "strength": {
          "default": 1.0,
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Strength",
          "type": "number"
        },
        "threshold": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Threshold"
        }
      },
      "title": "DecracklePlan",
      "type": "object"
    },
    "DocumentRef": {
      "additionalProperties": false,
      "description": "Reference from one document to another, pinned by digest.",
      "properties": {
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "title": "DocumentRef",
      "type": "object"
    },
    "ExportPlan": {
      "additionalProperties": false,
      "properties": {
        "bit_depth": {
          "default": 24,
          "enum": [
            16,
            24
          ],
          "title": "Bit Depth",
          "type": "integer"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "dither": {
          "default": "none",
          "enum": [
            "none",
            "tpdf"
          ],
          "title": "Dither",
          "type": "string"
        },
        "dither_seed": {
          "default": 0,
          "title": "Dither Seed",
          "type": "integer"
        },
        "format": {
          "default": "flac",
          "enum": [
            "flac",
            "wav",
            "aiff"
          ],
          "title": "Format",
          "type": "string"
        },
        "sample_rate": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Sample Rate"
        },
        "track_filename_template": {
          "default": "{index:02d} - {title}",
          "title": "Track Filename Template",
          "type": "string"
        },
        "write_tags": {
          "default": true,
          "title": "Write Tags",
          "type": "boolean"
        }
      },
      "title": "ExportPlan",
      "type": "object"
    },
    "MetadataPlan": {
      "additionalProperties": false,
      "properties": {
        "album": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Album"
        },
        "album_artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Album Artist"
        },
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "artwork_path": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artwork Path"
        },
        "catalog_number": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Catalog Number"
        },
        "comment": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Comment"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "disc_number": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Disc Number"
        },
        "discogs_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Discogs Release Id"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "genre": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Genre"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Label"
        },
        "musicbrainz_release_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Musicbrainz Release Id"
        },
        "styles": {
          "items": {
            "type": "string"
          },
          "title": "Styles",
          "type": "array"
        },
        "total_discs": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Discs"
        },
        "total_tracks": {
          "anyOf": [
            {
              "minimum": 1,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Total Tracks"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackTag"
          },
          "title": "Tracks",
          "type": "array"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "title": "MetadataPlan",
      "type": "object"
    },
    "NormalizePlan": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "engine": {
          "default": "native",
          "title": "Engine",
          "type": "string"
        },
        "mode": {
          "default": "album_peak",
          "enum": [
            "album_peak",
            "album_rms",
            "album_gated_rms",
            "track_peak",
            "none"
          ],
          "title": "Mode",
          "type": "string"
        },
        "peak_ceiling_db": {
          "anyOf": [
            {
              "maximum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Peak Ceiling Db"
        },
        "target_db": {
          "default": -1.0,
          "maximum": 0.0,
          "title": "Target Db",
          "type": "number"
        }
      },
      "title": "NormalizePlan",
      "type": "object"
    },
    "PrefilterPlan": {
      "additionalProperties": false,
      "description": "DC blocking and the subsonic high-pass, applied to the whole side before\nthe cuts.\n\nTwo one-line filters share a section because they answer the same question \u2014\nhow much of what the transfer captured below the music should reach the\nlistening copy \u2014 and neither justifies a stage of its own. Both are genuine\npreservation-versus-listening choices rather than constants, which is why they\nare here and not compiled in.\n\nDisabled by default, and the whole section is optional: a plan written before\n3.3 validates without it and executes to the same bytes.",
      "properties": {
        "dc_block": {
          "default": false,
          "title": "Dc Block",
          "type": "boolean"
        },
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": false,
          "title": "Enabled",
          "type": "boolean"
        },
        "engine": {
          "default": "native",
          "title": "Engine",
          "type": "string"
        },
        "highpass_hz": {
          "anyOf": [
            {
              "exclusiveMinimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Highpass Hz"
        },
        "highpass_rolloff_db_per_octave": {
          "default": 24,
          "enum": [
            6,
            12,
            18,
            24,
            30,
            36
          ],
          "title": "Highpass Rolloff Db Per Octave",
          "type": "integer"
        }
      },
      "title": "PrefilterPlan",
      "type": "object"
    },
    "SourceInfo": {
      "additionalProperties": false,
      "description": "Identity of the source recording a document refers to.\n\n``sha256`` is the anchor of reproducibility: the executor refuses to run a\nplan against audio whose digest does not match.",
      "properties": {
        "channels": {
          "exclusiveMinimum": 0,
          "title": "Channels",
          "type": "integer"
        },
        "duration_seconds": {
          "minimum": 0,
          "title": "Duration Seconds",
          "type": "number"
        },
        "num_samples": {
          "minimum": 0,
          "title": "Num Samples",
          "type": "integer"
        },
        "path": {
          "title": "Path",
          "type": "string"
        },
        "sample_rate": {
          "exclusiveMinimum": 0,
          "title": "Sample Rate",
          "type": "integer"
        },
        "sha256": {
          "title": "Sha256",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256",
        "sample_rate",
        "channels",
        "num_samples",
        "duration_seconds"
      ],
      "title": "SourceInfo",
      "type": "object"
    },
    "SplitPlan": {
      "additionalProperties": false,
      "properties": {
        "decision": {
          "anyOf": [
            {
              "$ref": "#/$defs/StageDecision"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "engine": {
          "default": "native",
          "title": "Engine",
          "type": "string"
        },
        "tracks": {
          "items": {
            "$ref": "#/$defs/TrackBoundary"
          },
          "title": "Tracks",
          "type": "array"
        }
      },
      "title": "SplitPlan",
      "type": "object"
    },
    "StageDecision": {
      "additionalProperties": false,
      "description": "Why this section looks the way it does.",
      "properties": {
        "confidence": {
          "anyOf": [
            {
              "maximum": 1.0,
              "minimum": 0.0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Confidence"
        },
        "inputs": {
          "items": {
            "type": "string"
          },
          "title": "Inputs",
          "type": "array"
        },
        "rationale": {
          "default": "",
          "title": "Rationale",
          "type": "string"
        },
        "skill": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Skill"
        }
      },
      "title": "StageDecision",
      "type": "object"
    },
    "TrackBoundary": {
      "additionalProperties": false,
      "description": "A cut, in integer source samples. Titles live in the metadata section \u2014\nthe plan must not carry the same string twice.\n\n``index`` is the track's position on the *album*, not within this plan: side B\nof a two-sided record continues where side A stopped, so both sides can be\nexported into one directory with correct numbering.",
      "properties": {
        "end_sample": {
          "exclusiveMinimum": 0,
          "title": "End Sample",
          "type": "integer"
        },
        "fade_in_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Fade In Ms",
          "type": "number"
        },
        "fade_out_ms": {
          "default": 0.0,
          "minimum": 0.0,
          "title": "Fade Out Ms",
          "type": "number"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "start_sample": {
          "minimum": 0,
          "title": "Start Sample",
          "type": "integer"
        }
      },
      "required": [
        "index",
        "start_sample",
        "end_sample"
      ],
      "title": "TrackBoundary",
      "type": "object"
    },
    "TrackTag": {
      "additionalProperties": false,
      "properties": {
        "artist": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Artist"
        },
        "index": {
          "minimum": 1,
          "title": "Index",
          "type": "integer"
        },
        "position": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Position"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "index",
        "title"
      ],
      "title": "TrackTag",
      "type": "object"
    }
  },
  "$id": "https://vinyl-process.invalid/schemas/processing_plan.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "analysis": {
      "anyOf": [
        {
          "$ref": "#/$defs/DocumentRef"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "created_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Created By"
    },
    "declick": {
      "$ref": "#/$defs/DeclickPlan"
    },
    "decrackle": {
      "$ref": "#/$defs/DecracklePlan"
    },
    "document_type": {
      "const": "processing_plan",
      "default": "processing_plan",
      "title": "Document Type",
      "type": "string"
    },
    "export": {
      "$ref": "#/$defs/ExportPlan"
    },
    "metadata": {
      "$ref": "#/$defs/MetadataPlan"
    },
    "normalize": {
      "$ref": "#/$defs/NormalizePlan"
    },
    "notes": {
      "default": "",
      "title": "Notes",
      "type": "string"
    },
    "prefilter": {
      "$ref": "#/$defs/PrefilterPlan"
    },
    "schema_version": {
      "default": "3.4",
      "title": "Schema Version",
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SourceInfo"
    },
    "split": {
      "$ref": "#/$defs/SplitPlan"
    }
  },
  "required": [
    "source",
    "split",
    "declick",
    "normalize",
    "metadata",
    "export"
  ],
  "title": "ProcessingPlan",
  "type": "object"
}
